# Local AI Song Studio - backend .env
# 로컬 실행용 최소 구성만 남겼습니다.

# Server
HOST=127.0.0.1
PORT=12000
RELOAD=true

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:30b
# 0 또는 비워두면 무제한 대기
OLLAMA_TIMEOUT=120

# ACE-Step API server
# 로컬 단독 사용 기준 필수 값
ACE_STEP_API_URL=http://127.0.0.1:8001

# 선택 값
# API 키는 로컬 단독 사용이면 비워도 됩니다
ACE_STEP_API_KEY=

# 모델 이름을 고정하고 싶을 때만 입력
ACE_STEP_API_MODEL=

# 상태 폴링 간격(초)
ACE_STEP_API_POLL_INTERVAL=5

# CLI fallback를 쓰는 경우에만 사용
ACE_STEP_CMD_TEMPLATE=
ACE_STEP_TIMEOUT=3600
